* the voltage source:
Vclk clk 0 PULSE(0 1.8 0 1000p 1000p 5000p 10n)
VDD vdd 0 DC 1.8
Vd d 0 PULSE(0 1.8 0 10p 10p 10n 20n)
Xdff1 clk d out vdd gnd dff1x
c_load out gnd 100f


* trans analysis
.tran 1p 50n

.meas tran trise TRIG V(out) VAL=0.36 RISE=1 TARG V(out) VAL=1.44 RISE=2

.meas tran tfall TRIG V(out) VAL=1.44 FALL=1 TARG V(out) VAL=0.36 FALL=1

.meas tran cellrise TRIG v(clk) VAL=0.9 FALL=3 TARG v(out) VAL=0.9 RISE=1

.meas tran cellfall TRIG v(clk) VAL=0.9 FALL=2 TARG v(out) VAL=0.9 FALL=1

.control
run
plot V(clk) V(out) V(d)         
.endc
.end
