*Setup Parameters
.param clk_slew=10p
.param d_slew=10p
.param t_width=5n 

*Voltage Sources
Vclk clk 0 PULSE(0 1.8 0 {clk_slew} {clk_slew} 5000p 10n)
VDD vdd 0 DC 1.8

* 1 -> 0 Transition Pulse: Starts high (1.8V), drops to 0V at 10ns, 
* and then rises back up to 1.8V after t_width.
Vd d 0 PULSE(1.8 0 10n {d_slew} {d_slew} {t_width} 200n)

Xdff1 clk d out vdd 0 dff1x
Xnot2 out out2 vdd 0 inv1x

.tran 1p 25n

.control
  set noaskquit
  set nomore

  echo ""
  echo " HOLD TIME EXTRACTION (1->0 TRANSITION) "
  
  foreach c_val 10p 1000p
    foreach d_val 10p 1000p
      
      echo "--- Testing CLK Slew = $c_val, D Slew = $d_val ---"
      
      * WIDER BOUNDS to safely accommodate extreme clock & data slews (up to 1000p)
      let t_pass = 7.0n
      let t_fail = 3.0n
      let diff = t_pass - t_fail
      
      * Binary search loop down to 1 picosecond tolerance
      while diff > 1p
        let t_try = (t_pass + t_fail) / 2
        
        alterparam clk_slew = $c_val
        alterparam d_slew = $d_val
        alterparam t_width = $&t_try
        reset
        
        run
        
        * Measure if output successfully dropped below 0.9V by 20ns
        meas tran v_out_check FIND v(out) AT=20n
        
        if v_out_check < 0.9
            let t_pass = t_try
        else
            let t_fail = t_try
        end
        let diff = t_pass - t_fail
      end
      
      alterparam t_width = $&t_pass
      reset
      run
      
      * Find 50% crossings
      meas tran time_clk WHEN v(clk)=0.9 fall=2
      meas tran time_d WHEN v(d)=0.9 rise=1
      
      let hold_ps = (time_d - time_clk) * 1e12
      
      echo ">> CLK Slew = $c_val | D Slew = $d_val | Final Hold Time = $&hold_ps ps<---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------"
      echo ""
      
    end
  end
.endc

.end
