* --- Power Supplies ---
VDD vdd 0 DC 1.8

* --- Dummy Source Declarations (Reconfigured in .control block) ---
Vclk clk 0 PULSE(1.8 0 5n 10p 10p 4.99n 10n)
* CHANGED: Data now starts HIGH (1.8) and transitions LOW (0)
Vd d 0 PULSE(1.8 0 14.5n 10p 10p 20n 40n)

* --- DUT ---
Xdff1 clk d out vdd 0 dff1x
Xnot2 out out2 vdd 0 inv1x

* --- Control Block: 2D Slew Sweep Binary Search ---
.control
  * 1. Define the slew matrix [10ps, 1000ps]
  let slews = vector(2)
  let slews[0] = 10e-12
  let slews[1] = 1000e-12
  
  let num_slews = 2

  echo "--- DFF SETUP TIME: 2D SLEW CHARACTERIZATION (1 -> 0) ---"

  let idx_clk = 0
  
  * Outer Loop: Clock Slew
  while idx_clk < num_slews
      let s_clk = slews[idx_clk]
      
      let idx_d = 0
      
      * Inner Loop: Data Slew
      while idx_d < num_slews
          let s_d = slews[idx_d]

          * 2. Configure 50% crossing geometry
          let clk_edge_start = 15.0n
          let clk_50 = clk_edge_start + (s_clk / 2.0)

          * 3. Adjust Vclk Pulse 
          let pw_clk = 5.0n - s_clk
          alter @Vclk[pulse] = [ 1.8 0 5n $&s_clk $&s_clk $&pw_clk 10n ]

          * 4. Binary Search Setup
          let td_min = 13.0n     
          let td_max = 16.0n     
          let tol = 0.001n
          let iter = 0

          while (td_max - td_min) > tol
              let iter = iter + 1
              let td = (td_min + td_max) / 2.0

              * CHANGED: Data edge transitions 1.8 -> 0 at 'td'
              alter @Vd[pulse] = [ 1.8 0 $&td $&s_d $&s_d 20n 40n ]
              
              tran 1p 20n
              
              * Measure output voltage 4ns after clock edge
              meas tran q_voltage FIND v(out) AT=19n

              * CHANGED: If successfully latched '0', output will be LOW (< 0.9)
              if q_voltage < 0.9
                  * PASS: Flipped successfully to 0
                  let td_min = td  
              else
                  * FAIL: Arrived too late (stayed 1)
                  let td_max = td  
              end
          end

          * 5. Final Calculation
          let data_50 = td_min + (s_d / 2.0)
          let best_setup = clk_50 - data_50
          
          echo "Clk Slew: $&s_clk s  |  Data Slew: $&s_d s  |  Setup: $&best_setup s"
          plot V(out) V(d) V(clk)
          
          let idx_d = idx_d + 1
      end
      echo "-----------------------------------------------------------------"
      let idx_clk = idx_clk + 1
  end
  echo "Sweep Complete."
.endc

.end
